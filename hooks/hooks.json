{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/block-wasteful-recursion.py"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
